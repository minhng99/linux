config REALTEK_RTD1296_GPU_POWER
	bool "Realtek RTD1296 GPU power domain"
	depends on (ARCH_REALTEK || COMPILE_TEST) && OF && PM
	depends on COMMON_CLK && RESET_CONTROLLER
	select MFD_SYSCON
	select PM_GENERIC_DOMAINS
	help
	  Control the GPU SRAM and memory-repair interface.
	  Sequence its clock and reset around power transitions.
	  Poll SRAM and repair completion before exposing the device.
	  Runtime PM powers down SRAM when the consumer becomes idle.

config REALTEK_RTD1296_TVE_POWER
	bool "Realtek RTD1296 TVE analogue power domain"
	depends on (ARCH_REALTEK || COMPILE_TEST) && OF && PM
	depends on COMMON_CLK && RESET_CONTROLLER
	select MFD_SYSCON
	select PM_GENERIC_DOMAINS
	help
	  Control the TVE analogue block used by the microphone ADC.
	  The provider manages the shared resets and analogue enable.
	  Its register clock is enabled only during control accesses.
	  Consumers use runtime PM to request the power domain.

config REALTEK_RTD1296_NAT_POWER
	bool "Realtek RTD1296 Ethernet switch SRAM power domain"
	depends on (ARCH_REALTEK || COMPILE_TEST) && OF && PM
	select MFD_SYSCON
	select PM_GENERIC_DOMAINS
	help
	  Control isolation and SRAM power for the RTD1296 Ethernet switch.
	  Consumers manage their own clocks and logic resets.
	  Power transitions wait for the SRAM controller to complete.
	  Consumers request the domain through runtime power management.
