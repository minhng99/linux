/*
 * Banana Pi BPI-W2
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

#include "rtd1296.dtsi"

/ {
	compatible = "bananapi,bpi-w2", "realtek,rtd1296";
	model = "Banana Pi BPI-W2";

	memory@1f000 {
		device_type = "memory";
		reg = <0x1f000 0x7ffe1000>;
	};

	aliases {
		serial0 = &uart0;
		mmc0 = &emmc;
		mmc1 = &sd;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	fan_supply: regulator-fan {
		compatible = "regulator-fixed";
		regulator-name = "fan-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&misc_gpio 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	thermal-zones {
		cpu-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&cpu_thermal_sensor>;

			trips {
				cpu_passive: passive {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
				};

				cpu_critical: critical {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	cpu_opp_table: opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <2000000>;
		};

		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <800000>;
		};

		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <800000>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <825000>;
		};

		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <850000>;
		};

		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <875000>;
			opp-suspend;
		};

		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <900000>;
		};

		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <925000>;
		};

		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <962500>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <1012500>;
		};

		opp-1300000000 {
			opp-hz = /bits/ 64 <1300000000>;
			opp-microvolt = <1062500>;
		};

		opp-1400000000 {
			opp-hz = /bits/ 64 <1400000000>;
			opp-microvolt = <1100000>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power";
			gpios = <&iso_gpio 30 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&iso_gpio 27 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_HEARTBEAT;
			gpios = <&misc_gpio 97 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};

		led-2 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&misc_gpio 98 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};

	sd_supply: regulator-sd {
		compatible = "regulator-fixed";
		regulator-name = "sd-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vdd_3v3>;
		gpio = <&misc_gpio 99 GPIO_ACTIVE_LOW>;
		startup-delay-us = <10000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sd_power_pins>;
	};
};

&uart0 {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu_thermal_sensor {
	status = "okay";
};

&rtc {
	status = "okay";
};

&i2c0 {
	status = "okay";

	pmic@12 {
		compatible = "gmt,g2227";
		reg = <0x12>;

		regulators {
			vdd_3v3: dcdc1 {
				regulator-name = "vdd-3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_cpu: dcdc2 {
				regulator-name = "vdd-cpu";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1187500>;
				regulator-settling-time-up-us = <1000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_gpu: dcdc3 {
				regulator-name = "vdd-gpu";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ddr: dcdc4 {
				regulator-name = "vdd-ddr";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_iso: dcdc5 {
				regulator-name = "vdd-iso";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_top: dcdc6 {
				regulator-name = "vdd-top";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_1v8: ldo2 {
				regulator-name = "vdd-1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_l2: ldo3 {
				regulator-name = "vdd-l2";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&sfc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		vcc-supply = <&vdd_3v3>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "atf";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "uboot_a";
				reg = <0x40000 0x400000>;
			};

			partition@440000 {
				label = "uboot_b";
				reg = <0x440000 0x400000>;
				read-only;
			};

			partition@840000 {
				label = "ubi_env";
				reg = <0x840000 0x7c0000>;
			};
		};
	};
};

&cr_pinctrl {
	emmc_pins: emmc-pins {
		function = "emmc";
		pins = "nf_cle", "nf_rd_n", "nf_rdy", "nf_dd_7", "nf_dd_6",
		       "nf_dd_5", "nf_dd_4", "nf_dd_3", "nf_dd_2", "nf_dd_1",
		       "nf_dd_0", "emmc_dd_sb";
	};

	sd_pins: sd-pins {
		function = "sd";
		pins = "mmc_cmd", "mmc_clk", "mmc_cd", "mmc_wp",
		       "mmc_data_0", "mmc_data_1", "mmc_data_2", "mmc_data_3";
	};

	sd_power_pins: sd-power-pins {
		function = "gpio";
		pins = "prob_2";
	};
};

&emmc {
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_pins>;
	bus-width = <8>;
	max-frequency = <26000000>;
	clk-phase-legacy = <0 180>;
	vmmc-supply = <&vdd_3v3>;
	vqmmc-supply = <&vdd_1v8>;
	disable-wp;
	status = "okay";
};

&sd {
	pinctrl-names = "default";
	pinctrl-0 = <&sd_pins>;
	bus-width = <4>;
	max-frequency = <25000000>;
	vmmc-supply = <&sd_supply>;
	disable-wp;
	no-1-8-v;
	no-mmc;
	no-sdio;
	status = "okay";
};
